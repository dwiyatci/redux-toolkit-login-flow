{
  "name": "redux-toolkit-login-flow",
  "version": "2.6.0",
  "private": true,
  "description": "A potentially reusable formalized login flow pattern for crafting web development project",
  "keywords": [
    "formalized pattern",
    "login flow",
    "react app",
    "react router app",
    "redux toolkit app",
    "web craftmanship"
  ],
  "bugs": "https://github.com/dwiyatci/redux-toolkit-login-flow/issues",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "Glenn Dwiyatcita <gmd@email.com> (https://tiny.cc/dwiyatci)",
  "repository": {
    "type": "git",
    "url": "https://github.com/dwiyatci/redux-toolkit-login-flow.git"
  },
  "type": "module",
  "scripts": {
    "cid": "pnpm clean-install-dedupe",
    "clean-install-dedupe": "pnpm clean-install && pnpm dedupe",
    "upgr": "pnpm upgrade --recursive --latest --interactive",
    "start": "vite",
    "test": "vitest",
    "preview": "vite preview",
    "build": "vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint ./src --quiet",
    "lint:report-warnings": "oxlint ./src"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "volta": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.24.0"
}
